# Copy to /etc/nebula/deployment.env. No passwords or keys belong in this file.
# Manager listens privately; the HTTPS proxy is the only public management API.
NEBULA_LISTEN=127.0.0.1:18081
NEBULA_PUBLIC_URL=https://47.103.58.159
NEBULA_MANAGER_URL=http://127.0.0.1:18081
NEBULA_TICKET_ISSUER=https://47.103.58.159
NEBULA_ALLOW_SELF_REGISTRATION=false

NEBULA_GATEWAY_LISTEN=0.0.0.0:7443
NEBULA_GATEWAY_ADVERTISE=47.103.58.159:7443
NEBULA_GATEWAY_NAME=cloud-gateway-1
NEBULA_GATEWAY_CERT=/var/lib/nebula/gateway/cert.pem
NEBULA_GATEWAY_KEY=/var/lib/nebula/gateway/key.pem

NEBULA_RELAY_LISTEN=0.0.0.0:7444
NEBULA_RELAY_ADVERTISE=47.103.58.159:7444
NEBULA_RELAY_NAME=cloud-relay-1
NEBULA_RELAY_CERT=/var/lib/nebula/relay/cert.pem
NEBULA_RELAY_KEY=/var/lib/nebula/relay/key.pem
NEBULA_REGION=default
RUST_LOG=info
NEBULA_LOG=info
