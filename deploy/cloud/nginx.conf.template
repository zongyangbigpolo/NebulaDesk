user nebula;
worker_processes auto;
pid /run/nebula-web.pid;
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log off;
    server_tokens off;
    client_max_body_size 2m;
    client_body_temp_path /var/lib/nebula/nginx/body;
    proxy_temp_path /var/lib/nebula/nginx/proxy;
    limit_req_zone $binary_remote_addr zone=nebula_auth:10m rate=10r/m;
    limit_req_status 429;

    server {
        listen @HTTPS_PORT@ ssl;
        server_name @PUBLIC_HOST@;
        ssl_certificate /opt/nebula/tls/live/nebula-manager/fullchain.pem;
        ssl_certificate_key /opt/nebula/tls/live/nebula-manager/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        location ~ ^/v1/auth/(login|register|accept-invitation)$ {
            limit_req zone=nebula_auth burst=10 nodelay;
            proxy_pass @MANAGER_UPSTREAM@;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
        }

        location / {
            proxy_pass @MANAGER_UPSTREAM@;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
