PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://nebula:nebula@localhost:5432/nebula_cloud?schema=public
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_SESSION_SECRET=change-me-session-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_TOKEN_TTL_SECONDS=60
CLAIM_CODE_TTL_SECONDS=3600
DEVICE_ONLINE_WINDOW_SECONDS=120
RELAY_PUBLIC_HOST=127.0.0.1
RELAY_PUBLIC_PORT=7100
RELAY_SHARED_SECRET=change-me-relay-shared-secret
# Comma-separated emails that get role=ADMIN automatically on registration —
# bootstraps the very first admin(s). Leave empty and no one is an admin
# until an existing admin promotes someone via PATCH /admin/users/:id/role.
INITIAL_ADMIN_EMAILS=admin@example.com
# Shared secret that lets any LOGGED-IN user self-register a device under
# their own account via POST /devices/self-register (no admin/claim-code step
# needed first) — see README.md's "Self-registration & trial credit". Leave
# empty (the default) to disable self-registration entirely.
DEVICE_ENROLLMENT_TOKEN=change-me-enrollment-token
# New accounts start with this many seconds of "connect" credit; each
# successful POST /devices/:id/connect deducts CONNECT_CREDIT_COST_SECONDS
# from it (flat cost per connect, admins are never metered). An admin tops up
# via PATCH /admin/users/:id/credit.
DEFAULT_TRIAL_CREDIT_SECONDS=600
CONNECT_CREDIT_COST_SECONDS=600
